{
  "name": "@quartz-community/obsidian-flavored-markdown",
  "version": "0.1.0",
  "packageManager": "npm@12.0.2",
  "description": "Obsidian Flavored Markdown transformer plugin for Quartz",
  "type": "module",
  "license": "MIT",
  "author": "Quartz Community",
  "homepage": "https://github.com/quartz-community/obsidian-flavored-markdown",
  "repository": {
    "type": "git",
    "url": "https://github.com/quartz-community/obsidian-flavored-markdown"
  },
  "keywords": [
    "quartz",
    "quartz-plugin",
    "obsidian",
    "obsidian-flavored-markdown",
    "remark",
    "rehype",
    "mdast",
    "hast"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format && npm run test"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": false
    }
  },
  "dependencies": {
    "@quartz-community/rehype-obsidian": "^0.1.2",
    "@quartz-community/remark-obsidian": "^0.2.4",
    "@quartz-community/types": "^0.3.0",
    "@quartz-community/utils": "^0.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "github-slugger": "^2.0.0",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "mdast-util-to-hast": "^13.2.1",
    "preact": "^10.29.8",
    "prettier": "^3.9.6",
    "rehype-raw": "^7.0.0",
    "sass": "^1.103.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12"
  },
  "quartz": {
    "name": "obsidian-flavored-markdown",
    "displayName": "Obsidian Flavored Markdown",
    "category": "transformer",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 30,
    "defaultEnabled": true,
    "defaultOptions": {
      "enableInHtmlEmbed": false,
      "enableCheckbox": true
    }
  }
}
