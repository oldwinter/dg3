filters:
  and:
    - or:
        - topics.contains(link("skills 合集 - fileclass"))
properties:
  title:
    displayName: 标题
  description:
    displayName: 描述
  skill_collection_type:
    displayName: 合集类型
  skill_collection_recommendation:
    displayName: 推荐级别
  why_worth_watching:
    displayName: 为什么值得看
  topics:
    displayName: 主题
  aliases:
    displayName: 别名
  tags:
    displayName: 标签
  status:
    displayName: 状态
  type:
    displayName: 类型
  publish:
    displayName: 发布
  up:
    displayName: 上级
  created:
    displayName: 创建日期
  modified:
    displayName: 修改日期
  insight_generated_at:
    displayName: 洞察生成时间
  insights:
    displayName: 洞察
  github_primary_repo:
    displayName: 主仓库
  github_primary_url:
    displayName: 主仓库地址
  github_stars_total:
    displayName: Stars
  github_forks_total:
    displayName: Forks
  github_open_issues:
    displayName: Issues
  repo_count:
    displayName: 仓库数
  github_license:
    displayName: License
  github_language:
    displayName: 主语言
  github_last_push:
    displayName: 最近 Push
  github_checked_at:
    displayName: GitHub 检查时间
views:
  - type: table
    name: 技能合集总览
    order:
      - file.name
      - 个人评分
      - github_primary_url
      - github_stars_total
      - skill_collection_type
      - why_worth_watching
      - github_last_push
      - github_checked_at
      - description
      - status
      - modified
    sort:
      - property: 个人评分
        direction: DESC
      - property: github_stars_total
        direction: DESC
      - property: modified
        direction: DESC
      - property: title
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 254
      note.github_primary_url: 302
      note.github_stars_total: 92
      note.description: 305
  - type: table
    name: 待整理
    filters:
      or:
        - status == "review"
        - status == "draft"
    order:
      - file.name
      - title
      - description
      - skill_collection_type
      - skill_collection_recommendation
      - why_worth_watching
      - topics
      - status
      - insights
      - modified
    sort:
      - property: modified
        direction: DESC
      - property: title
        direction: ASC
  - type: table
    name: 来源/入口
    filters:
      or:
        - type == "source"
        - up
    order:
      - file.name
      - title
      - skill_collection_type
      - github_primary_url
      - github_stars_total
      - github_forks_total
      - github_open_issues
      - repo_count
      - github_license
      - up
      - aliases
      - publish
      - created
      - modified
    sort:
      - property: type
        direction: ASC
      - property: modified
        direction: DESC
